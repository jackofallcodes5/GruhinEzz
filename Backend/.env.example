PORT=5000

# ─── Supabase / PostgreSQL ───────────────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173

# ─── Email / SMTP (used for OTP emails) ─────────────────────────────────────
# For Gmail: enable 2FA → https://myaccount.google.com/apppasswords
# Then generate a 16-character App Password and paste it below (no spaces).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="GruhinEzz <your_gmail@gmail.com>"

# ─── Admin Credentials ───────────────────────────────────────────────────────
ADMIN=admin@gruhinezz.com
ADMIN_PASS=your_admin_password

# ─── Cashfree Payment Gateway (https://merchant.cashfree.com/) ───────────────
# Set CASHFREE_ENV to SANDBOX for testing, PRODUCTION for live real money payments
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here


















