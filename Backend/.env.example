PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gruhinezz

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173

# Resend Email (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=GruhinEzz <no-reply@yourdomain.com>

# Cashfree Payment Gateway (https://merchant.cashfree.com/)
# Set CASHFREE_ENV to SANDBOX for testing, PRODUCTION for live real money payments
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
